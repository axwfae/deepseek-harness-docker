{
  "name": "dsh-lightpanda-cdp",
  "version": "0.1.0",
  "description": "Drive a remote Lightpanda headless browser over CDP from DeepSeek Harness: open pages, read markdown, list interactive elements, click/fill, screenshot and evaluate JS.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cdp",
    "lightpanda",
    "browser",
    "headless"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./dsh/index.js",
    "./cdp": "./dsh/cdp.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
