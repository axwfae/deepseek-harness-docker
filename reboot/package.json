{
  "name": "dsh-manual-reboot",
  "version": "0.1.0",
  "description": "手动重启 DeepSeek Harness：设置页一键重启当前 dsh 进程，按原启动参数重新拉起。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.0-rc.6"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
